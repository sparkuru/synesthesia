#!/usr/bin/env bash
# hako - Run Linux development commands in rust:1.90-bookworm.
# No host Rust installation is needed. Sources mount at /app with host UID/GID.
# Usage: ./hako rustup toolchain install 1.90.0 --profile minimal --component rustfmt --component clippy --no-self-update
#        ./hako cargo fmt --all -- --check
#        ./hako cargo check --workspace --all-targets --locked
#        ./hako cargo clippy --workspace --all-targets --locked -- -D warnings
#        ./hako cargo test --workspace --locked
# C1 has no development service: no ports are published and no dev.sh exists.
# Windows uses native cargo commands and never requires this Linux wrapper.
set -Eeuo pipefail

# Editable host defaults; no service port has been established for C1.
readonly HAKO_BIND_HOST="${HAKO_BIND_HOST:-127.0.0.1}"
readonly HAKO_IMAGE="${HAKO_IMAGE:-rust:1.90-bookworm}"
readonly HAKO_NETWORK="${HAKO_NETWORK:-bridge}"
step_index=0

require_command() {
    command -v "$1" >/dev/null 2>&1 || {
        printf 'Error: required command not found: %s\n' "$1" >&2
        exit 127
    }
}

log_step() {
    local label=$1
    shift
    step_index=$((step_index + 1))
    printf '#%s [hako %s]' "$step_index" "$label" >&2
    printf ' %q' "$@" >&2
    printf '\n' >&2
}

main() {
    if [[ $# -eq 0 || ${1:-} == --help ]]; then
        printf 'Usage: ./hako COMMAND [ARG ...]\nLinux ephemeral Rust checks; no ports or persistent services.\n' >&2
        return 0
    fi
    [[ -z ${HAKO_SERVICE:-} ]] || {
        printf 'Error: C1 has no port-mapped development service.\n' >&2
        return 2
    }
    require_command docker
    require_command id
    require_command dirname
    require_command mkdir
    local repo_root
    repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
    log_step internal mkdir -p -- "$repo_root/.devhome"
    mkdir -p -- "$repo_root/.devhome"
    local -a tty_flags=()
    [[ ! -t 0 ]] || tty_flags+=(-i)
    [[ ! -t 0 || ! -t 1 ]] || tty_flags+=(-t)
    local -a command=(
        docker run --rm "${tty_flags[@]}"
        --user "$(id -u):$(id -g)" --network "$HAKO_NETWORK"
        -e HOME=/app/.devhome -e CARGO_HOME=/app/.devhome/cargo
        -e RUSTUP_HOME=/app/.devhome/rustup
        -v "$repo_root:/app" -w /app
        --label "hako.repo=$repo_root" --label "hako.scope=${HAKO_SCOPE:-manual}"
        --label hako.service=
        "$HAKO_IMAGE" "$@"
    )
    log_step run "${command[@]}"
    exec "${command[@]}"
}

main "$@"
